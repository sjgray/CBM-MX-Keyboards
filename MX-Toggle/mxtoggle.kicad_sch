	(text "The ATTINY senses key presses from the KEY\nswitch, debounces the input, and tells the\n4066 to connect or disconnect the STATE pins."
		(exclude_from_sim no)
		(at 90.932 102.362 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left bottom)
		)
		(uuid "4e9b8a40-7023-4431-8a3c-ef17ff1c5791")
	)
	(text "HEADER"
		(exclude_from_sim no)
		(at 238.252 78.486 0)
		(effects
			(font
				(size 2.9972 2.9972)
				(thickness 0.5994)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "56f84c09-b5fc-4e0a-90ec-5840bed69d6e")
	)
	(text "This is a small PCB that implements Mike Naberezny's\nMX-Lock circuit to add a soft-toggle for MX keyboards\nneeding a locking key, such as SHIFT-LOCK.\n\n* It requires 5V to power\n* Pin header to connect:\n	- Power: +5V, GND\n	- MX Key input: 2 lines\n	- State pins: 2 lines\n	- Status LED\n* UPDI programming header\n* When the MX Key is pressed the\n  locking state is toggled. When\n  the state is \"ON\" the State pins\n  are connected, otherwise they\n  are disconnected.\n* Status LED shows state.\n* Remembers state when power is off."
		(exclude_from_sim no)
		(at 16.002 182.118 0)
		(effects
			(font
				(size 1.5494 1.5494)
			)
			(justify left bottom)
		)
		(uuid "58b430f0-911e-4575-bc18-1ddaf33820b1")
	)
	(text "DESCRIPTION"
		(exclude_from_sim no)
		(at 16.256 135.636 0)
		(effects
			(font
				(size 4 4)
				(thickness 0.5994)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "649e008c-1a1e-46a2-a2ed-daf4ec7b59fd")
	)
